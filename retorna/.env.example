# ─── Supabase (PostgreSQL / REST) ───
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-key-or-anon-key

# ─── Telegram Bot ───
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ─── Anthropic (Agente IA - opcional para lenguaje natural avanzado) ───
ANTHROPIC_API_KEY=

# ─── Aplicación ───
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info
